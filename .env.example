# Discord Release Webhook URL
# Create a webhook in Discord's #other-releases channel:
#   1. Go to #other-releases channel
#   2. Server Settings → Integrations → Webhooks → New Webhook
#   3. Copy the webhook URL and paste below
DISCORD_RELEASE_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
