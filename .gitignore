# Allow current spec and build scripts (needed for builds from any computer)
!SmartCitizen.spec
!scripts/build/

# Runtime Data Files (auto-generated/downloaded)
data/global.ini
data/global.ini.bak
data/base_version.txt
data/contracts_version.txt

# Stats JSON source cache (downloaded by generate_stats_ini.py, ~109 MB)
**/stats_cache/

# Local DataForge extraction scratch (Game2.dcb + unforge output, ~300 MB)
/Data/

# Local scratch dir for ad-hoc experiments / diff dumps
/temp/

# Build-time flag module — written by build_exe.py --portable, deleted
# after the build finishes. Should never be committed; if it is, it'd
# silently flip the default-build behavior.
src/utils/_build_info.py

# Portable-mode runtime data (when running locally with IS_PORTABLE flipped)
/portable_data/
/scratch/
